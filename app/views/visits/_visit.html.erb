<div id="<%= dom_id visit %>">
  <div>
    <strong>Visitor:</strong>
    <%= visit.visitor_id %>
  </div>

  <div>
    <strong>Unit:</strong>
    <%= visit.unit_id %>
  </div>

  <div>
    <strong>Sector:</strong>
    <%= visit.sector_id %>
  </div>

  <div>
    <strong>User:</strong>
    <%= visit.user_id %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= visit.status %>
  </div>

  <div>
    <strong>Date time:</strong>
    <%= visit.date_time %>
  </div>

</div>
